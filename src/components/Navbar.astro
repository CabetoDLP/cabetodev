---
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;
const isEn = currentLang === 'english';
---

<header class="fixed top-0 left-0 w-full z-50 px-4 sm:px-6 py-3.5 backdrop-blur-md bg-slate-950/80 border-b border-red-500/20">
  <div class="max-w-7xl mx-auto flex items-center justify-between lg:justify-center gap-4 lg:gap-6 xl:gap-8">
    
    <!-- Logo & Nombre -->
    <a 
      href="#" 
      onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;" 
      class="flex items-center gap-2.5 font-mono text-base sm:text-lg font-bold tracking-wider text-white hover:text-red-400 transition-colors group shrink-0 whitespace-nowrap"
    >
      <img 
        src="/favicon-96x96.png" 
        alt="CabetoDev Logo" 
        class="w-7 h-7 object-contain rounded-md group-hover:scale-105 transition-transform duration-300 shrink-0"
      />
      <span class="inline-block">
        <span class="text-red-500">&lt;</span>CabetoDev <span class="text-red-500">/&gt;</span>
      </span>
    </a>

    <!-- Navegación Central -->
    <nav class="hidden lg:flex items-center gap-2.5 xl:gap-4 2xl:gap-5 text-[11px] xl:text-xs 2xl:text-sm font-mono tracking-tight xl:tracking-wider uppercase text-slate-300 whitespace-nowrap">
      <a href="#presentation" class="hover:text-red-400 transition-colors">{t.aPresentationText}</a>
      <a href="#services" class="hover:text-red-400 transition-colors">{t.aServicesText}</a>
      <a href="#projects" class="hover:text-red-400 transition-colors">{t.aProjectsText}</a>
      <a href="#skills" class="hover:text-red-400 transition-colors">{t.aSkillsText}</a>
      <a href="#performance" class="hover:text-red-400 transition-colors">{t.aPerformanceText}</a>
      <a href="#experience" class="hover:text-red-400 transition-colors">{t.aExperienceText}</a>
      <a href="#education" class="hover:text-red-400 transition-colors">{t.aStudiesText}</a>
      <a href="#faq" class="hover:text-red-400 transition-colors">{t.aFaqText}</a>
      <a href="#contact" class="hover:text-red-400 transition-colors">{t.aContactText}</a>
    </nav>

    <!-- Contenedor Derecho -->
    <div class="flex items-center gap-2.5 xl:gap-3 shrink-0">
      <!-- Selector de Idioma -->
      <div class="flex items-center bg-slate-900 border border-red-500/30 rounded-lg p-0.5 text-xs font-mono">
        <button 
          type="button"
          onclick="window.switchLanguage('es')"
          class="btn-lang-es px-2.5 py-1 rounded transition-all cursor-pointer bg-red-600 text-white font-bold"
        >
          ES
        </button>
        <button 
          type="button"
          onclick="window.switchLanguage('en')"
          class="btn-lang-en px-2.5 py-1 rounded transition-all cursor-pointer text-slate-400 hover:text-white"
        >
          EN
        </button>
      </div>

      <!-- Botón Contacto -->
      <a
        href={`#contact`}
        class="hidden sm:inline-block px-3.5 xl:px-4 py-1.5 rounded-lg font-mono text-xs font-bold uppercase border border-red-500/50 bg-red-950/40 text-red-400 hover:bg-red-600 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(239,68,68,0.2)] whitespace-nowrap"
      >
        {t.aContactText}
      </a>
    </div>

  </div>
</header>