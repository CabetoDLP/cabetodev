---
// src/components/Navbar.astro
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;
---

<header class="fixed top-0 left-0 w-full z-50 px-6 py-4 backdrop-blur-md bg-slate-950/70 border-b border-red-500/20">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    
    <a href={currentLang === 'english' ? '/en/' : '/es/'} class="flex items-center gap-2.5 font-mono text-lg font-bold tracking-wider text-white hover:text-red-400 transition-colors group">
      <img 
        src="/favicon-512x512.png" 
        alt="CabetoDev Logo" 
        class="w-7 h-7 object-contain rounded-md group-hover:scale-105 transition-transform duration-300"
      />
      <span>
        <span class="text-red-500">&lt;</span>CabetoDev <span class="text-red-500">/&gt;</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-xs font-mono tracking-widest uppercase text-slate-300">
      <a href="#presentation" class="hover:text-red-400 transition-colors">{t.aPresentationText}</a>
      <a href="#skills" class="hover:text-red-400 transition-colors">{t.aSkillsText}</a>
      <a href="#experience" class="hover:text-red-400 transition-colors">{t.aExperienceText}</a>
      <a href="#education" class="hover:text-red-400 transition-colors">{t.aStudiesText}</a>
      <a href="#projects" class="hover:text-red-400 transition-colors">{t.aProjectsText}</a>
      <a href="#contact" class="hover:text-red-400 transition-colors">{t.aContactText}</a>
      <a href="#files" class="hover:text-red-400 transition-colors">{t.aFilesText}</a>
    </nav>

    <div class="flex items-center gap-4">
      <div class="flex items-center bg-slate-900 border border-red-500/30 rounded-lg p-1 text-xs font-mono">
        <a 
          href="/es/" 
          class={`px-2 py-1 rounded transition-all ${currentLang === 'spanish' ? 'bg-red-600 text-white font-bold' : 'text-slate-400 hover:text-white'}`}
        >
          ES
        </a>
        <a 
          href="/en/" 
          class={`px-2 py-1 rounded transition-all ${currentLang === 'english' ? 'bg-red-600 text-white font-bold' : 'text-slate-400 hover:text-white'}`}
        >
          EN
        </a>
      </div>

      <a
        href="#contact"
        class="hidden sm:inline-block px-4 py-2 rounded-lg font-mono text-xs font-bold uppercase border border-red-500/50 bg-red-950/40 text-red-400 hover:bg-red-600 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(239,68,68,0.2)]"
      >
        {t.aContactText}
      </a>
    </div>

  </div>
</header>