---
import { ui } from '../language/ui';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = ui[lang];

const services = [
  {
    icon: `<svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    title: t.service1Title,
    description: t.service1Desc,
    features: [
      t.service1Feature1,
      t.service1Feature2,
      t.service1Feature3,
      t.service1Feature4
    ]
  },
  {
    icon: `<svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: t.service2Title,
    description: t.service2Desc,
    features: [
      t.service2Feature1,
      t.service2Feature2,
      t.service2Feature3,
      t.service2Feature4
    ]
  },
  {
    icon: `<svg class="w-8 h-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>`,
    title: t.service3Title,
    description: t.service3Desc,
    features: [
      t.service3Feature1,
      t.service3Feature2,
      t.service3Feature3,
      t.service3Feature4
    ]
  }
];
---

<section id="services" class="py-16 px-4 max-w-7xl mx-auto">
  <!-- Header de la Sección -->
  <div class="mb-12">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-wider flex items-center gap-3">
      <span class="text-red-500">//</span> {t.servicesTitle}
    </h2>
    <p class="mt-3 text-slate-400 max-w-2xl text-base md:text-lg">
      {t.servicesSubtitle}
    </p>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {services.map((service) => (
      <div class="group relative bg-slate-900/60 border border-slate-800 hover:border-red-500/50 rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between backdrop-blur-sm hover:shadow-[0_0_25px_rgba(239,68,68,0.15)]">
        <div>
          <!-- Icono -->
          <div class="flex items-center justify-between mb-6">
            <div class="p-3 bg-red-500/10 rounded-xl border border-red-500/20 group-hover:scale-110 transition-transform duration-300" set:html={service.icon} />
          </div>

          <!-- Título y Descripción -->
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">
            {service.title}
          </h3>
          <p class="text-slate-400 text-sm mb-6 leading-relaxed">
            {service.description}
          </p>

          <!-- Features List -->
          <ul class="space-y-2.5">
            {service.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-xs md:text-sm text-slate-300">
                <svg class="w-4 h-4 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>