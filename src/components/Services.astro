---
// src/components/Services.astro
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;

const services = [
  {
    icon: `<svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    title: t.service1Title,
    description: t.service1Desc,
    features: [
      t.service1Feature1,
      t.service1Feature2,
      t.service1Feature3,
      t.service1Feature4
    ],
    color: '#EF4444'
  },
  {
    icon: `<svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: t.service2Title,
    description: t.service2Desc,
    features: [
      t.service2Feature1,
      t.service2Feature2,
      t.service2Feature3,
      t.service2Feature4
    ],
    color: '#06B6D4'
  },
  {
    icon: `<svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>`,
    title: t.service3Title,
    description: t.service3Desc,
    features: [
      t.service3Feature1,
      t.service3Feature2,
      t.service3Feature3,
      t.service3Feature4
    ],
    color: '#8B5CF6'
  }
];
---

<section id="services" class="relative py-20 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden">
  <!-- Header de la Sección -->
  <div class="mb-14 text-center md:text-left">
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white flex items-center justify-center md:justify-start gap-3">
      <span class="text-red-500">//</span> {t.servicesTitle}
    </h2>
    <p class="text-slate-400 text-base max-w-2xl mt-2 leading-relaxed">
      {t.servicesSubtitle}
    </p>
  </div>

  <!-- Cards Grid con Efecto 3D -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {services.map((service) => (
      <div class="perspective-container">
        <div 
          class="card-3d relative p-6 sm:p-8 rounded-2xl bg-slate-950/80 border backdrop-blur-xl transition-all duration-500 h-full flex flex-col justify-between group"
          style={`
            border-color: ${service.color}40;
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.8), 0 0 25px ${service.color}15;
          `}
        >
          <div 
            class="absolute -inset-0.5 rounded-2xl opacity-0 group-hover:opacity-20 transition-opacity duration-500 blur-xl pointer-events-none"
            style={`background: ${service.color};`}
          ></div>

          <div>
            <!-- Header con Icono -->
            <div class="flex items-center justify-between mb-6">
              <div 
                class="p-3.5 rounded-2xl bg-slate-900/90 border border-slate-800 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                style={`border-color: ${service.color}30;`}
              >
                <div set:html={service.icon} />
              </div>
            </div>

            <!-- Título y Descripción -->
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-red-400 transition-colors">
              {service.title}
            </h3>
            <p class="text-slate-400 text-sm mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- Features List -->
            <ul class="space-y-2.5">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                  <span class="text-red-500 shrink-0 mt-0.5">▸</span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Accent Bar -->
          <div class="pt-6 mt-6 border-t border-slate-800/80 flex items-center justify-end">
            <div 
              class="w-2.5 h-2.5 rounded-full shadow-[0_0_10px_currentColor]"
              style={`background-color: ${service.color}; color: ${service.color};`}
            ></div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .perspective-container {
    perspective: 1000px;
  }

  .card-3d {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .perspective-container:hover .card-3d {
    transform: rotateX(4deg) rotateY(-2deg) translateZ(12px);
  }

  @media (max-width: 640px) {
    .perspective-container:hover .card-3d {
      transform: translateY(-4px);
    }
  }
</style>