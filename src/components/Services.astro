---
// src/components/Services.astro
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;

const services = [
  {
    icon: `<svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: t.s1Title,
    price: t.s1Price,
    time: t.s1Time,
    stack: ["Astro", "Next.js", "Tailwind CSS"],
    description: t.s1Desc,
    ideal: t.s1Ideal,
    features: [t.s1F1, t.s1F2, t.s1F3, t.s1F4, t.s1F5],
    color: '#EF4444'
  },
  {
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    title: t.s2Title,
    price: t.s2Price,
    time: t.s2Time,
    stack: ["Astro", "Next.js (SSG)", "Tailwind CSS"],
    description: t.s2Desc,
    ideal: t.s2Ideal,
    features: [t.s2F1, t.s2F2, t.s2F3, t.s2F4],
    color: '#06B6D4'
  },
  {
    icon: `<svg class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: t.s3Title,
    price: t.s3Price,
    time: t.s3Time,
    stack: ["Next.js", "Node.js / .NET", "PostgreSQL"],
    description: t.s3Desc,
    ideal: t.s3Ideal,
    features: [t.s3F1, t.s3F2, t.s3F3, t.s3F4],
    color: '#8B5CF6'
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M12 5l7 7-7 7" /></svg>`,
    title: t.s4Title,
    price: t.s4Price,
    time: t.s4Time,
    stack: ["React / Next.js", "Node.js / ASP.NET", "PostgreSQL / SQL Server"],
    description: t.s4Desc,
    ideal: t.s4Ideal,
    features: [t.s4F1, t.s4F2, t.s4F3, t.s4F4],
    color: '#10B981'
  }
];

const retainers = [
  { name: t.r1Name, price: t.r1Price, desc: t.r1Desc, service: t.r1Service, color: '#EF4444' },
  { name: t.r2Name, price: t.r2Price, desc: t.r2Desc, service: t.r2Service, color: '#06B6D4' },
  { name: t.r3Name, price: t.r3Price, desc: t.r3Desc, service: t.r3Service, color: '#10B981' }
];
---

<section id="services" class="relative py-20 px-4 sm:px-6 max-w-7xl mx-auto overflow-hidden">
  <!-- Header de la Sección -->
  <div class="mb-14 text-center md:text-left">
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white flex items-center justify-center md:justify-start gap-3">
      <span class="text-red-500">//</span> {t.servicesTitle}
    </h2>
    <p class="text-slate-400 text-base max-w-3xl mt-2 leading-relaxed">
      {t.servicesSubtitle}
    </p>
  </div>

  <!-- Grid de Servicios Principal (4 Tarjetas) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
    {services.map((service) => (
      <div class="perspective-container">
        <div 
          class="card-3d relative p-6 sm:p-8 rounded-2xl bg-slate-950/90 border backdrop-blur-xl transition-all duration-500 h-full flex flex-col justify-between group"
          style={`
            border-color: ${service.color}35;
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.8), 0 0 20px ${service.color}10;
          `}
        >
          <div 
            class="absolute -inset-0.5 rounded-2xl opacity-0 group-hover:opacity-15 transition-opacity duration-500 blur-xl pointer-events-none"
            style={`background: ${service.color};`}
          ></div>

          <div>
            <!-- Header con Icono, Precio y Tiempo -->
            <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
              <div 
                class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                style={`border-color: ${service.color}40;`}
              >
                <div set:html={service.icon} />
              </div>

              <div class="text-right">
                <span class="block text-xl sm:text-2xl font-extrabold text-white" style={`color: ${service.color};`}>
                  {service.price}
                </span>
                <span class="text-xs text-slate-400 font-mono">
                  {t.estTime} {service.time}
                </span>
              </div>
            </div>

            <!-- Título -->
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-2 group-hover:text-red-400 transition-colors">
              {service.title}
            </h3>

            <!-- Stack Tags -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {service.stack.map((tech) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-slate-900 text-slate-300 border border-slate-800">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Descripción -->
            <p class="text-slate-400 text-sm mb-5 leading-relaxed">
              {service.description}
            </p>

            <!-- Features List -->
            <div class="mb-6">
              <h4 class="text-xs uppercase tracking-wider font-semibold text-slate-400 mb-3">Qué incluye:</h4>
              <ul class="space-y-2">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300">
                    <span class="text-red-500 shrink-0 mt-0.5">▸</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom: Cliente Ideal -->
          <div class="pt-4 border-t border-slate-800/80 mt-auto">
            <p class="text-xs text-slate-400 leading-normal">
              <strong class="text-slate-200">{t.idealClient}</strong> {service.ideal}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Sección Esquema de Mantenimiento Recurrente (Retainers) -->
  <div class="mt-16 pt-12 border-t border-slate-800/80">
    <div class="mb-10 text-center md:text-left">
      <h3 class="text-2xl sm:text-3xl font-bold text-white flex items-center justify-center md:justify-start gap-3">
        <span class="text-red-500">//</span> {t.retainersTitle}
      </h3>
      <p class="text-slate-400 text-sm max-w-2xl mt-2">
        {t.retainersSubtitle}
      </p>
    </div>

    <!-- Vista de Tarjetas para Retainers -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {retainers.map((plan) => (
        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-md flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h4 class="text-lg font-bold text-white">{plan.name}</h4>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
                {plan.service}
              </span>
            </div>
            <div class="text-xl font-black mb-4" style={`color: ${plan.color};`}>
              {plan.price}
            </div>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
              {plan.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .perspective-container {
    perspective: 1000px;
  }

  .card-3d {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .perspective-container:hover .card-3d {
    transform: rotateX(2deg) rotateY(-1deg) translateZ(8px);
  }

  @media (max-width: 640px) {
    .perspective-container:hover .card-3d {
      transform: translateY(-4px);
    }
  }
</style>