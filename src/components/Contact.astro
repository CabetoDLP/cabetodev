---
// src/components/Contact.astro
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;
---

<section id="contact" class="relative py-20 px-6 max-w-5xl mx-auto z-10">
  <div class="mb-12 text-center space-y-3">
    <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">
      <span class="text-red-500">//</span> {t.contactTitle}
    </h2>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto font-sans">
      {t.contactSubtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Redes y Canales de Contacto -->
    <div class="lg:col-span-5 grid grid-cols-2 gap-4">
      
      <a 
        href="https://instagram.com/cabeto.art" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-slate-900/80 border border-slate-800 hover:border-pink-500/50 rounded-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(236,72,153,0.25)] flex flex-col items-center text-center gap-3"
      >
        <div class="p-3 bg-pink-500/10 rounded-xl text-pink-400 group-hover:scale-110 transition-transform">
          <img src="/icons/instagram.svg" alt="Instagram" class="w-7 h-7 filter invert" />
        </div>
        <div>
          <h3 class="font-bold text-white text-sm">Instagram</h3>
          <p class="text-xs text-slate-400">@cabeto.art</p>
        </div>
      </a>

      <a 
        href="https://www.linkedin.com/in/carlos-alberto-de-la-pe%C3%B1a-j%C3%A1come-0bba3526a/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-slate-900/80 border border-slate-800 hover:border-sky-500/50 rounded-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(14,165,233,0.25)] flex flex-col items-center text-center gap-3"
      >
        <div class="p-3 bg-sky-500/10 rounded-xl text-sky-400 group-hover:scale-110 transition-transform">
          <img src="/icons/linkedin.svg" alt="LinkedIn" class="w-7 h-7 filter invert" />
        </div>
        <div>
          <h3 class="font-bold text-white text-sm">LinkedIn</h3>
          <p class="text-xs text-slate-400">Carlos de la Peña</p>
        </div>
      </a>

      <a 
        href="https://github.com/CabetoDLP" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-slate-900/80 border border-slate-800 hover:border-purple-500/50 rounded-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(168,85,247,0.25)] flex flex-col items-center text-center gap-3"
      >
        <div class="p-3 bg-purple-500/10 rounded-xl text-purple-400 group-hover:scale-110 transition-transform">
          <img src="/icons/github.svg" alt="GitHub" class="w-7 h-7 filter invert" />
        </div>
        <div>
          <h3 class="font-bold text-white text-sm">GitHub</h3>
          <p class="text-xs text-slate-400">CabetoDLP</p>
        </div>
      </a>

      <a 
        href="https://wa.me/573052927115"  
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 rounded-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(16,185,129,0.25)] flex flex-col items-center text-center gap-3"
      >
        <div class="p-3 bg-emerald-500/10 rounded-xl text-emerald-400 group-hover:scale-110 transition-transform">
          <img src="/icons/whatsapp.svg" alt="WhatsApp" class="w-7 h-7 filter invert" />
        </div>
        <div>
          <h3 class="font-bold text-white text-sm">WhatsApp</h3>
          <p class="text-xs text-slate-400">{t.contactWhatsappLabel}</p>
        </div>
      </a>

      <a 
        href="https://discord.com/users/252258312978956290" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group p-5 bg-slate-900/80 border border-slate-800 hover:border-[#505FF7]/50 rounded-2xl backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(80,95,247,0.3)] flex flex-col items-center text-center gap-3"
      >
        <div class="p-3 bg-[#505FF7]/20 rounded-xl text-[#505FF7] group-hover:scale-110 transition-transform">
          <img src="/icons/discord.svg" alt="Discord" class="w-7 h-7 filter invert" />
        </div>
        <div>
          <h3 class="font-bold text-white text-sm">Discord</h3>
          <p class="text-xs text-slate-400">@cabeto.art</p>
        </div>
      </a>

    </div>

    <!-- Formulario de Contacto -->
    <div class="lg:col-span-7">
      <form 
        id="contact-form"
        class="contact-form space-y-5 bg-slate-900/80 p-8 border border-red-500/30 rounded-2xl backdrop-blur-xl shadow-[0_0_50px_rgba(220,38,38,0.1)]"
        data-send-message={t.sendMessage}
        data-error-message={t.sendErrorMessage}
        data-success-title={t.modalSuccessTitle}
        data-error-title={t.modalErrorTitle}
        data-confirm-btn={t.modalConfirmBtn}
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-mono text-slate-400 mb-2 uppercase">{t.formName}</label>
            <input 
              type="text" 
              id="form-name"
              placeholder={t.formNamePlaceholder} 
              class="w-full bg-slate-950/80 border border-slate-800 focus:border-red-500 rounded-xl px-4 py-3 text-white placeholder:text-slate-600 focus:outline-none transition-colors" 
              required
            />
          </div>
          <div>
            <label class="block text-xs font-mono text-slate-400 mb-2 uppercase">{t.formEmail}</label>
            <input 
              type="email" 
              id="form-email"
              placeholder={t.formEmailPlaceholder} 
              class="w-full bg-slate-950/80 border border-slate-800 focus:border-red-500 rounded-xl px-4 py-3 text-white placeholder:text-slate-600 focus:outline-none transition-colors" 
              required
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-400 mb-2 uppercase">{t.formMessage}</label>
          <textarea 
            id="form-message"
            rows="4" 
            placeholder={t.formMessagePlaceholder} 
            class="w-full bg-slate-950/80 border border-slate-800 focus:border-red-500 rounded-xl px-4 py-3 text-white placeholder:text-slate-600 focus:outline-none transition-colors"
            required
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="send-btn"
          class="w-full py-4 rounded-xl font-bold text-xs sm:text-sm tracking-wider uppercase bg-red-600 text-white shadow-[0_0_25px_rgba(220,38,38,0.4)] hover:bg-red-500 hover:shadow-[0_0_35px_rgba(220,38,38,0.6)] transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {t.sendButton}
        </button>
      </form>
    </div>

  </div>

  <!-- Modal de Estado del Mensaje -->
  <div id="contact-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="relative w-full max-w-md rounded-2xl bg-slate-950 border border-red-500/40 p-6 sm:p-8 shadow-[0_0_50px_rgba(239,68,68,0.25)] transform scale-95 transition-transform duration-300">
      <button id="close-contact-modal" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-900 border border-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-lg transition-colors">
        ✕
      </button>

      <div id="contact-modal-content" class="text-center space-y-4 pt-2">
        <!-- El contenido dinámico se inyecta por JavaScript -->
      </div>
    </div>
  </div>
</section>

<!-- EmailJS SDK e Inicialización -->
<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script is:inline>
  if (typeof emailjs !== 'undefined') {
    emailjs.init('SAgSIGAClA8pFzI8A');
  }

  const form = document.getElementById('contact-form');
  const modal = document.getElementById('contact-modal');
  const closeModalBtn = document.getElementById('close-contact-modal');
  const modalContent = document.getElementById('contact-modal-content');

  const openContactModal = (isSuccess, text) => {
    if (!modalContent || !modal || !form) return;

    const titleSuccess = form.getAttribute('data-success-title') || '// ¡Mensaje Enviado!';
    const titleError = form.getAttribute('data-error-title') || '// Error al Enviar';
    const btnText = form.getAttribute('data-confirm-btn') || 'Aceptar';

    modalContent.innerHTML = `
      <div class="mx-auto w-12 h-12 rounded-full ${isSuccess ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-red-500/10 text-red-400 border border-red-500/30'} flex items-center justify-center text-xl font-bold">
        ${isSuccess ? '✓' : '✕'}
      </div>
      <h3 class="text-xl font-black uppercase text-white tracking-wide">
        ${isSuccess ? titleSuccess : titleError}
      </h3>
      <p class="text-slate-300 text-sm leading-relaxed">
        ${text}
      </p>
      <button 
        id="modal-confirm-btn" 
        class="w-full mt-4 py-3 rounded-xl font-bold text-xs uppercase tracking-wider ${isSuccess ? 'bg-emerald-600 hover:bg-emerald-500 shadow-[0_0_20px_rgba(16,185,129,0.3)]' : 'bg-red-600 hover:bg-red-500 shadow-[0_0_20px_rgba(220,38,38,0.4)]'} text-white transition-all"
      >
        ${btnText}
      </button>
    `;

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.firstElementChild?.classList.remove('scale-95');

    document.getElementById('modal-confirm-btn')?.addEventListener('click', closeContactModal);
  };

  const closeContactModal = () => {
    if (!modal) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modal.firstElementChild?.classList.add('scale-95');
  };

  closeModalBtn?.addEventListener('click', closeContactModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeContactModal();
  });

  if (form) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();

      const sendBtn = document.getElementById('send-btn');
      if (sendBtn) sendBtn.disabled = true;

      const successMsg = form.getAttribute('data-send-message') || "Mensaje enviado exitosamente";
      const errorMsg = form.getAttribute('data-error-message') || "Ocurrió un error al enviar el mensaje";

      const nameVal = document.getElementById('form-name').value;
      const emailVal = document.getElementById('form-email').value;
      const messageVal = document.getElementById('form-message').value;

      emailjs.send("service_mwy96o9", "template_lkgggnn", {
        from_name: nameVal,
        message: messageVal,
        email_id: emailVal
      })
      .then(() => {
        openContactModal(true, successMsg);
        form.reset();
      })
      .catch((error) => {
        openContactModal(false, errorMsg);
        console.error("Error EmailJS:", error);
      })
      .finally(() => {
        if (sendBtn) sendBtn.disabled = false;
      });
    });
  }
</script>