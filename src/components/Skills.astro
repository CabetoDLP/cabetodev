---
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;

const categories = [
  {
    title: 'Frontend UI/UX',
    skills: [
      { name: 'TypeScript', icon: '/Technologies/typescript.svg', color: '#3178C6' },
      { name: 'JavaScript', icon: '/Technologies/javascript.svg', color: '#F7DF1E' },
      { name: 'React', icon: '/Technologies/react.svg', color: '#61DAFB' },
      { name: 'Next.js', icon: '/Technologies/nextjs.svg', color: '#FFFFFF' },
      { name: 'HTML5', icon: '/Technologies/html.svg', color: '#E34F26' },
      { name: 'CSS3', icon: '/Technologies/css.svg', color: '#1572B6' },
      { name: 'Tailwind CSS', icon: '/Technologies/tailwind.svg', color: '#06B6D4' },
      { name: 'Material UI', icon: '/Technologies/materialui.svg', color: '#007FFF' },
    ],
    direction: 'carousel-ring-cw',
  },
  {
    title: 'Backend & Databases',
    skills: [
      { name: 'Node.js', icon: '/Technologies/nodejs.svg', color: '#5FA04E' },
      { name: '.NET', icon: '/Technologies/net.svg', color: '#512BD4' },
      { name: 'Spring Boot', icon: '/Technologies/springboot.svg', color: '#6DB33F' },
      { name: 'PostgreSQL', icon: '/Technologies/postgresql.svg', color: '#4169E1' },
      { name: 'SQL Server', icon: '/Technologies/sqlserver.svg', color: '#CC292B' },
      { name: 'MongoDB', icon: '/Technologies/mongodb.svg', color: '#47A248' },
    ],
    direction: 'carousel-ring-cw', // Cambiado a CW para coincidir con Frontend
  },
  {
    title: 'DevOps & Cloud',
    skills: [
      { name: 'Azure', icon: '/Technologies/azure.svg', color: '#0089D6' },
      { name: 'Vercel', icon: '/Technologies/vercel.svg', color: '#FFFFFF' },
      { name: 'Render', icon: '/Technologies/render.svg', color: '#46E3B7' },
      { name: 'Cloudinary', icon: '/Technologies/cloudinary.svg', color: '#3448C5' },
    ],
    direction: 'carousel-ring-cw',
  },
];
---

<section id="skills" class="relative py-20 px-4 sm:px-6 max-w-[90rem] mx-auto overflow-hidden">
  <div class="mb-16 text-center md:text-left">
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white flex items-center justify-center md:justify-start gap-3">
      <span class="text-red-500">//</span> {t.skillsTitle}
    </h2>
    <p class="text-slate-400 text-base max-w-2xl mt-2 leading-relaxed">
      {t.skillsText}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-6 items-center">
    {categories.map((cat) => {
      const total = cat.skills.length;
      const cardWidth = 110;
      const radius = Math.round((cardWidth / (2 * Math.tan(Math.PI / total))) + 35);

      return (
        <div class="flex flex-col items-center w-full">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-red-500/30 text-[11px] font-mono tracking-widest uppercase text-red-400 mb-8 backdrop-blur-md shadow-[0_0_15px_rgba(239,68,68,0.15)]">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
            {cat.title}
          </div>

          <div class="carousel-viewport relative w-full h-[220px] sm:h-[240px] flex items-center justify-center">
            <div 
              class={`carousel-ring ${cat.direction} relative w-[100px] sm:w-[110px] h-[140px] sm:h-[150px]`}
              style={`--radius: ${radius}px;`}
            >
              {cat.skills.map((skill, index) => {
                const angle = (360 / total) * index;
                return (
                  <div
                    class="carousel-card absolute inset-0 flex flex-col items-center justify-center p-3 rounded-2xl bg-slate-950/85 border backdrop-blur-md transition-all duration-300 hover:scale-110"
                    style={`
                      --angle: ${angle}deg;
                      --skill-color: ${skill.color};
                      transform: rotateY(${angle}deg) translateZ(${radius}px);
                      border-color: ${skill.color}60;
                      box-shadow: 0 0 20px ${skill.color}20, inset 0 0 12px ${skill.color}15;
                    `}
                  >
                    <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center mb-2">
                      <img
                        src={skill.icon}
                        alt={skill.name}
                        class="w-full h-full object-contain"
                        style={`filter: drop-shadow(0 0 6px ${skill.color}aa);`}
                      />
                    </div>

                    <span class="text-[11px] sm:text-xs font-bold tracking-wide text-white text-center line-clamp-1">
                      {skill.name}
                    </span>

                    <div
                      class="w-5 h-1 rounded-full mt-2 shadow-[0_0_6px_currentColor]"
                      style={`background-color: ${skill.color}; color: ${skill.color};`}
                    ></div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .carousel-viewport {
    perspective: 800px;
  }

  .carousel-ring {
    transform-style: preserve-3d;
  }

  .carousel-ring-cw {
    animation: rotateCarouselCW 28s infinite linear;
  }

  .carousel-ring-ccw {
    animation: rotateCarouselCCW 28s infinite linear;
  }

  .carousel-ring:hover {
    animation-play-state: paused;
  }

  .carousel-card {
    backface-visibility: visible;
  }

  @keyframes rotateCarouselCW {
    from {
      transform: rotateX(-6deg) rotateY(0deg);
    }
    to {
      transform: rotateX(-6deg) rotateY(360deg);
    }
  }

  @keyframes rotateCarouselCCW {
    from {
      transform: rotateX(-6deg) rotateY(360deg);
    }
    to {
      transform: rotateX(-6deg) rotateY(0deg);
    }
  }

  @media (max-width: 640px) {
    .carousel-viewport {
      perspective: 650px;
      transform: scale(0.85);
    }
  }
</style>