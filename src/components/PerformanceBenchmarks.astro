---
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const isEn = currentLang === 'english';

const benchmarks = [
  {
    id: 'cabetodev',
    title: 'Cabeto.dev (Personal Portfolio)',
    category: isEn ? 'Personal Platform' : 'Plataforma Personal',
    url: 'https://cabeto.dev',
    scores: { perf: 98, access: 96, best: 100, seo: 100 },
    metrics: { lcp: '1.2s', fcp: '0.6s', cls: '0.00' },
    stack: ['Astro', 'Tailwind', 'Cloudflare'],
    pageSpeedUrl: 'https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fcabeto.dev'
  },
  {
    id: 'rocaire',
    title: 'Rocaire Constructora',
    category: isEn ? 'Corporate Landing Page' : 'Sitio Corporativo',
    url: 'https://www.rocaireconstructora.com/',
    scores: { perf: 95, access: 98, best: 100, seo: 100 },
    metrics: { lcp: '1.4s', fcp: '0.8s', cls: '0.01' },
    stack: ['Next.js', 'Tailwind', 'Vercel'],
    pageSpeedUrl: 'https://pagespeed.web.dev/analysis?url=https%3A%2F%2Fwww.rocaireconstructora.com%2F'
  }
];
---

<section id="benchmarks" class="relative py-20 px-4 sm:px-6 max-w-7xl mx-auto">
  <!-- Encabezado de la Sección -->
  <div class="mb-14 text-center md:text-left">
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white flex items-center justify-center md:justify-start gap-3">
      <span class="text-red-500">//</span> {isEn ? 'PERFORMANCE BENCHMARKS' : 'RENDIMIENTO DEMOSTRADO'}
    </h2>
    <p class="text-slate-400 text-base max-w-2xl mt-2 leading-relaxed">
      {isEn 
        ? 'Real Google PageSpeed Insights results across production environments. High performance guaranteed on every build.' 
        : 'Resultados reales de Google PageSpeed Insights en entornos de producción. Garantía de velocidad y optimización en cada sitio.'}
    </p>
  </div>

  <!-- Grid de Casos de Rendimiento -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    {benchmarks.map((item) => (
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-950/90 border border-red-500/30 backdrop-blur-xl shadow-[0_10px_30px_rgba(0,0,0,0.5)] flex flex-col justify-between">
        <div>
          <!-- Header de Tarjeta -->
          <div class="flex items-start justify-between gap-4 mb-6">
            <div>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-red-950/60 border border-red-500/40 text-red-400 uppercase tracking-wider">
                {item.category}
              </span>
              <h3 class="text-xl font-bold text-white mt-2">{item.title}</h3>
            </div>
            
            <a 
              href={item.pageSpeedUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 hover:border-red-500/50 text-slate-300 text-xs font-mono flex items-center gap-1.5 transition-all"
            >
              <span>Audit</span>
              <svg class="w-3.5 h-3.5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Los 4 Anillos de Lighthouse -->
          <div class="grid grid-cols-4 gap-2 py-4 px-3 rounded-xl bg-slate-900/60 border border-slate-800/80 mb-6 text-center">
            <div>
              <div class="text-xl sm:text-2xl font-black text-emerald-400">{item.scores.perf}</div>
              <div class="text-[10px] font-mono text-slate-400 uppercase mt-0.5">Performance</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-black text-emerald-400">{item.scores.access}</div>
              <div class="text-[10px] font-mono text-slate-400 uppercase mt-0.5">Accessibility</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-black text-emerald-400">{item.scores.best}</div>
              <div class="text-[10px] font-mono text-slate-400 uppercase mt-0.5">Best Practices</div>
            </div>
            <div>
              <div class="text-xl sm:text-2xl font-black text-emerald-400">{item.scores.seo}</div>
              <div class="text-[10px] font-mono text-slate-400 uppercase mt-0.5">SEO</div>
            </div>
          </div>

          <!-- Métricas Clave (Core Web Vitals) -->
          <div class="grid grid-cols-3 gap-3 mb-6">
            <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800 text-center">
              <span class="block text-[10px] font-mono text-slate-400 uppercase">LCP</span>
              <span class="text-sm font-bold text-white">{item.metrics.lcp}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800 text-center">
              <span class="block text-[10px] font-mono text-slate-400 uppercase">FCP</span>
              <span class="text-sm font-bold text-white">{item.metrics.fcp}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/40 border border-slate-800 text-center">
              <span class="block text-[10px] font-mono text-slate-400 uppercase">CLS</span>
              <span class="text-sm font-bold text-white">{item.metrics.cls}</span>
            </div>
          </div>
        </div>

        <!-- Footer de la tarjeta (Stack usado) -->
        <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <div class="flex gap-1.5">
            {item.stack.map((tech) => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800">
                {tech}
              </span>
            ))}
          </div>
          <span class="text-xs font-mono text-emerald-400 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Verified
          </span>
        </div>
      </div>
    ))}
  </div>
</section>