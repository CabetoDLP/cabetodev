---
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;

const faqs = [
  { q: t.faq1Q, a: t.faq1A, id: '01' },
  { q: t.faq2Q, a: t.faq2A, id: '02' },
  { q: t.faq3Q, a: t.faq3A, id: '03' },
  { q: t.faq4Q, a: t.faq4A, id: '04' },
  { q: t.faq5Q, a: t.faq5A, id: '05' },
  { q: t.faq6Q, a: t.faq6A, id: '06' },
];
---

<section id="faq" class="py-20 relative overflow-hidden">
  <!-- Efecto de brillo de fondo -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-red-600/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Encabezado de la Sección (Alineado a la izquierda) -->
    <div class="mb-12 text-left">
      <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white flex items-center justify-start gap-3">
        <span class="text-red-500">//</span> {t.faqTitle}
      </h2>

      <!-- Etiqueta / Subtítulo de Metodología y Condiciones debajo del Título -->
      <div class="mt-3">
        <span class="inline-block px-3 py-1 rounded-full bg-red-950/60 border border-red-500/30 text-red-400 font-mono text-xs uppercase tracking-widest">
          {t.faqBadge}
        </span>
      </div>

      <p class="text-slate-400 text-base max-w-2xl mt-3 leading-relaxed">
        {t.faqSubtitle}
      </p>
    </div>

    <!-- Lista de Preguntas Acordeón -->
    <div class="space-y-4 max-w-4xl">
      {faqs.map((faq) => (
        <details class="group bg-slate-950/80 border border-slate-800/80 hover:border-red-500/40 rounded-2xl transition-all duration-300 backdrop-blur-xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer select-none text-left">
            <div class="flex items-center gap-4">
              <span class="font-mono text-xs text-red-500 font-bold bg-red-950/40 px-2.5 py-1 rounded-lg border border-red-500/20">
                {faq.id}
              </span>
              <h3 class="text-white font-semibold text-sm sm:text-base group-hover:text-red-400 transition-colors">
                {faq.q}
              </h3>
            </div>
            <span class="ml-4 shrink-0 text-slate-400 group-open:-rotate-180 transition-transform duration-300">
              <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          
          <div class="px-6 pb-6 pt-2 text-slate-300 text-sm leading-relaxed border-t border-slate-900 font-sans">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>