---
import { languages, ui } from '../language/ui';

interface Props {
  lang?: keyof typeof languages | keyof typeof ui;
}

const { lang = 'spanish' } = Astro.props;
const currentLang = (lang === 'es' ? 'spanish' : lang === 'en' ? 'english' : lang) as 'spanish' | 'english';
const t = ui[currentLang] || ui.spanish;

// Mapeo dinámico según la estructura dentro de public/cvs/
const cvPath = currentLang === 'english' 
  ? '/cvs/CV_Carlos_De_La_Pena.pdf' 
  : '/cvs/HV_Carlos_De_La_Pena.pdf';

const cvFileName = currentLang === 'english' 
  ? 'CV_Carlos_De_La_Pena.pdf' 
  : 'HV_Carlos_De_La_Pena.pdf';
---

<section id="files" class="relative py-20 px-6 max-w-5xl mx-auto z-10">
  <div class="relative overflow-hidden bg-slate-900/80 border border-slate-800 hover:border-red-500/40 rounded-3xl p-8 sm:p-10 backdrop-blur-xl transition-all duration-300 shadow-[0_0_50px_rgba(0,0,0,0.5)]">
    
    <div class="absolute -right-20 -bottom-20 w-60 h-60 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 relative z-10">
      
      <div class="space-y-3 text-center lg:text-left max-w-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-500/10 border border-red-500/20 rounded-full text-xs font-mono text-red-400 uppercase tracking-widest">
          <span>//</span> {t.filesBadge}
        </div>
        <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white">
          {t.filesTitle}
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          {t.filesDescription}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 w-full lg:w-auto">
        <a
          href={cvPath}
          download={cvFileName}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl font-bold text-xs sm:text-sm tracking-wider uppercase bg-red-600 text-white shadow-[0_0_25px_rgba(220,38,38,0.4)] hover:bg-red-500 hover:shadow-[0_0_35px_rgba(220,38,38,0.6)] transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          {t.downloadCvButton}
        </a>
      </div>

    </div>
  </div>
</section>