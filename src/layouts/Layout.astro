---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';

import plusJakartaWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2';
import spaceGrotesk600Woff2 from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2';
import spaceGrotesk700Woff2 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2';

import Chatbot from '../components/Chatbot.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'spanish' | 'english' | 'es' | 'en';
}

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const {  
  title = 'Carlos de la Peña | Full Stack Engineer & Software Developer',  
  description = 'Portafolio profesional de Carlos Alberto de la Peña Jácome. Ingeniero de Sistemas y Desarrollador Full Stack especializado en React, Next.js, Node.js y C#.',
  lang = 'spanish'  
} = Astro.props;

const siteUrl = 'https://cabeto.dev';
const currentLang = (lang === 'en' || lang === 'english') ? 'en' : 'es';

const jsonLdPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Carlos Alberto de la Peña Jácome',
  alternateName: ['Carlos de la Peña', 'CabetoDev', 'Cabeto'],
  url: siteUrl,
  jobTitle: 'Full Stack Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Freelance / Full Stack Engineer'
  },
  sameAs: [
    'https://github.com/CarlosDeLaPena',
    'https://github.com/CabetoDLP',
    'https://www.linkedin.com/in/carlos-alberto-de-la-pe%C3%B1a-j%C3%A1come-0bba3526a/',
    'https://www.instagram.com/cabetodp/'
  ]
};

const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CabetoDev',
  alternateName: ['Carlos de la Peña Portfolio', 'Cabeto Dev'],
  url: siteUrl
};
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- PRECARGA DINÁMICA DE FUENTES CRÍTICAS -->
    <link rel="preload" href={plusJakartaWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={spaceGrotesk600Woff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={spaceGrotesk700Woff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- SEO Principal -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Carlos Alberto de la Peña Jácome" />
    <meta name="keywords" content="Carlos de la Peña, CabetoDev, cabetodev, Developer, Web Developer, Full Stack Engineer, Software Developer, React, Next.js, Node.js, TypeScript, Astro, Systems Engineer, Portafolio" />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/favicon-512x512.png`} />
    <meta property="og:site_name" content="CabetoDev" />
    <meta property="og:locale" content={currentLang === 'es' ? 'es_CO' : 'en_US'} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/favicon-512x512.png`} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192x192.png" />

    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <script is:inline>
      // Interceptor global de scroll inteligente por idioma
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;
        
        const href = link.getAttribute('href');
        if (href && href.startsWith('#') && href.length > 1) {
          e.preventDefault();
          const currentLang = document.documentElement.lang || 'es';
          const targetId = href.substring(1);
          
          // Si estamos en inglés, busca primero el ID con sufijo '-en' dentro del bloque visible
          const finalId = currentLang === 'en' ? `${targetId}-en` : targetId;
          const targetElement = document.getElementById(finalId) || document.getElementById(targetId);
          
          if (targetElement) {
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    </script>
  </head>
  
  <body class="bg-slate-950 text-white font-sans min-h-screen relative overflow-x-hidden selection:bg-red-500 selection:text-white">
    <!-- Capas de fondo y ambientación con renderizado optimizado -->
    <div class="fixed inset-0 bg-[linear-gradient(to_right,#1f293750_1px,transparent_1px),linear-gradient(to_bottom,#1f293750_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_50%_80%_at_50%_50%,#000_85%,transparent_100%)] pointer-events-none z-0"></div>
    <div class="fixed top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-red-600/20 rounded-full blur-[140px] pointer-events-none z-0"></div>
    <div class="fixed bottom-10 right-10 w-[350px] h-[350px] bg-purple-600/15 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <!-- Contenido principal inyectado -->
    <div class="relative z-10">
      <slot />
    </div>

    <!-- Componentes Flotantes Adaptados a la Arquitectura por Idioma -->
    <!-- Componentes Flotantes Adaptados a la Arquitectura por Idioma -->
    <div data-lang="es">
      <Chatbot lang="es" />
      <WhatsAppButton lang="es" />
    </div>
    <div data-lang="en">
      <Chatbot lang="en" />
      <WhatsAppButton lang="en" />
    </div>
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --font-heading: 'Space Grotesk', sans-serif;
    --font-body: 'Plus Jakarta Sans Variable', sans-serif;
  }

  body {
    font-family: var(--font-body);
    font-display: swap;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-display: swap;
  }

  /* Control dinámico de idioma por CSS con aislamiento de renderizado */
  html[lang="es"] .only-en,
  html[lang="es"] [data-lang="en"] { 
    display: none !important; 
    content-visibility: hidden !important;
  }

  html[lang="en"] .only-es,
  html[lang="en"] [data-lang="es"] { 
    display: none !important; 
    content-visibility: hidden !important;
  }
</style>