---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Performance from '../components/Performance.astro';
import Experience from '../components/Experience.astro';
import Studies from '../components/Studies.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
---

<Layout 
  title="CabetoDev | Desarrollador Full Stack e Ingeniero De Sistemas"
  description="Sitio oficial de Carlos Alberto de la Peña Jácome. Ingeniero de Sistemas y Desarrollador Full Stack freelance."
  lang="es"
>
  <style>
    /* CORRECCIÓN: Solo usar display para evitar bloqueos de renderizado y scroll */
    html[lang="es"] [data-lang="en"] { display: none !important; }
    html[lang="en"] [data-lang="es"] { display: none !important; }
  </style>

  <script is:inline>
    const seoMeta = {
      es: {
        title: "CabetoDev | Ingeniero De Sistemas y Desarrollador Full Stack",
        description: "Sitio oficial de Carlos Alberto de la Peña Jácome. Ingeniero de Sistemas y Desarrollador Full Stack freelance."
      },
      en: {
        title: "CabetoDev | Systems Engineer & Full Stack Developer",
        description: "Official portfolio of Carlos Alberto de la Peña Jácome. Systems Engineer and Full Stack Developer."
      }
    };

    window.switchLanguage = function(lang) {
      localStorage.setItem('preferred_lang', lang);
      document.documentElement.lang = lang;

      const meta = seoMeta[lang] || seoMeta.es;
      document.title = meta.title;
      const metaDesc = document.querySelector('meta[name="description"]');
      if (metaDesc) {
        metaDesc.setAttribute('content', meta.description);
      }

      const btnsEs = document.querySelectorAll('.btn-lang-es');
      const btnsEn = document.querySelectorAll('.btn-lang-en');

      if (lang === 'en') {
        btnsEn.forEach(b => { b.classList.add('bg-red-600', 'text-white', 'font-bold'); b.classList.remove('text-slate-400'); });
        btnsEs.forEach(b => { b.classList.remove('bg-red-600', 'text-white', 'font-bold'); b.classList.add('text-slate-400'); });
      } else {
        btnsEs.forEach(b => { b.classList.add('bg-red-600', 'text-white', 'font-bold'); b.classList.remove('text-slate-400'); });
        btnsEn.forEach(b => { b.classList.remove('bg-red-600', 'text-white', 'font-bold'); b.classList.add('text-slate-400'); });
      }
    };

    // Interceptor global de scroll optimizado para buscar dentro del bloque activo
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;
      
      const href = link.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        e.preventDefault();
        const targetId = href.substring(1);
        const currentLang = document.documentElement.lang || 'es';
        
        // Selecciona el contenedor activo según el idioma actual
        const activeBlock = document.querySelector(`[data-lang="${currentLang}"]`);
        const targetElement = activeBlock 
          ? activeBlock.querySelector(`#${targetId}`) 
          : document.getElementById(targetId);

        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });

    // Autodetección al cargar la página
    document.addEventListener('DOMContentLoaded', () => {
      const savedLang = localStorage.getItem('preferred_lang');
      const userLang = savedLang || (navigator.language || 'es').toLowerCase();
      
      if (userLang.startsWith('en') || savedLang === 'en') {
        window.switchLanguage('en');
      } else {
        window.switchLanguage('es');
      }
    });
  </script>

  <!-- BLOQUE ÚNICO EN ESPAÑOL -->
  <div data-lang="es">
    <Navbar lang="es" />
    <main class="pt-16">
      <Hero lang="es" />
      <Services lang="es" />
      <Projects lang="es" />
      <Skills lang="es" />
      <Performance lang="es" />
      <Experience lang="es" />
      <Studies lang="es" />
      <Faq lang="es" />
      <Contact lang="es" />
    </main>
  </div>

  <!-- BLOQUE ÚNICO EN INGLÉS -->
  <div data-lang="en">
    <Navbar lang="en" />
    <main class="pt-16">
      <Hero lang="en" />
      <Services lang="en" />
      <Projects lang="en" />
      <Skills lang="en" />
      <Performance lang="en" />
      <Experience lang="en" />
      <Studies lang="en" />
      <Faq lang="en" />
      <Contact lang="en" />
    </main>
  </div>
</Layout>