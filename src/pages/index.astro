---
// src/pages/index.astro
// Detección automática del idioma del cliente mediante la cabecera 'Accept-Language'

const acceptLanguage = Astro.request.headers.get('accept-language') || '';

// Si el idioma preferido del usuario contiene 'en' (inglés), lo manda a /en/, si no a /es/
const preferredLang = acceptLanguage.toLowerCase().includes('en') ? '/en/' : '/es/';

return Astro.redirect(preferredLang);
---