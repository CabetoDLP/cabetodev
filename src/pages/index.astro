---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Studies from '../components/Studies.astro';
import Projects from '../components/Projects.astro';
import Files from '../components/Files.astro';
import Contact from '../components/Contact.astro';

const paramLang = Astro.url.searchParams.get('lang');
const lang = (paramLang === 'en' || paramLang === 'english') ? 'english' : 'spanish';

const pageTitle = lang === 'english' 
  ? 'Carlos de la Peña | Full Stack Engineer & Portfolio' 
  : 'Carlos de la Peña | Ingeniero de Sistemas & Desarrollador Full Stack';

const pageDescription = lang === 'english'
  ? 'Official portfolio of Carlos Alberto de la Peña Jácome. Full Stack Software Engineer focused on web applications, modern architectures, and web development.'
  : 'Portafolio oficial de Carlos Alberto de la Peña Jácome. Ingeniero de Sistemas y Desarrollador Full Stack enfocado en aplicaciones web y arquitectura de software.';
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
  <Navbar lang={lang} />
  <main class="pt-16">
    <Hero lang={lang} />
    <Skills lang={lang} />
    <Experience lang={lang} />
    <Studies lang={lang} />
    <Projects lang={lang} />
    <Contact lang={lang} />
    <Files lang={lang} />
  </main>
</Layout>