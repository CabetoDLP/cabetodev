---
// src/pages/index.astro
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CabetoDev | Full Stack Developer</title>
    
    <!-- Detección instantánea de idioma antes de pintar la pantalla -->
    <script is:inline>
      (function() {
        try {
          // 1. Obtener idioma del navegador (ej: 'en-US', 'es-CO')
          const userLang = (navigator.language || navigator.userLanguage || 'es').toLowerCase();
          
          // 2. Verificar si ya redirigimos en esta sesión para evitar bucles en Safari
          const hasRedirected = sessionStorage.getItem('i18n_redirected');

          if (!hasRedirected) {
            sessionStorage.setItem('i18n_redirected', 'true');
            if (userLang.startsWith('en')) {
              window.location.replace('/en/');
            } else {
              window.location.replace('/es/');
            }
          }
        } catch (e) {
          // Si el navegador bloquea scripts o storage, cae al fallback
          window.location.replace('/es/');
        }
      })();
    </script>

    <!-- Fallback si el usuario tiene JavaScript totalmente desactivado -->
    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
  </head>
  <body class="bg-slate-950"></body>
</html>