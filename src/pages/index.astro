---
// src/pages/index.astro
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script>
      const userLang = navigator.language || 'es';
      window.location.replace(userLang.toLowerCase().startsWith('en') ? '/en/' : '/es/');
    </script>
  </head>
  <body class="bg-slate-950">
    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
  </body>
</html>