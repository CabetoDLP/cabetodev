---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Carlos de la Peña | Portfolio</title>
    <script is:inline>
      // Detecta el idioma preferido del navegador y redirige a la subcarpeta correspondiente
      const userLang = navigator.language || navigator.userLanguage || '';
      const targetLang = userLang.toLowerCase().startsWith('en') ? 'en' : 'es';
      
      window.location.replace(`/${targetLang}/`);
    </script>
  </head>
  <body class="bg-slate-950 text-white flex items-center justify-center min-h-screen">
    <p class="font-mono text-xs text-slate-400 animate-pulse">// Redirigiendo...</p>
  </body>
</html>