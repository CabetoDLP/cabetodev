---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Skills from '../../components/Skills.astro';
import Experience from '../../components/Experience.astro';
import Studies from '../../components/Studies.astro';
import Projects from '../../components/Projects.astro';
import Services from '../../components/Services.astro';
import Contact from '../../components/Contact.astro';
import Faq from '../../components/Faq.astro';

const lang = 'english'; // o 'en' según manejes tu objeto ui
---

<Layout 
  title="Carlos de la Peña | Systems Engineer & Full Stack Developer"
  description="Official portfolio of Carlos Alberto de la Peña Jácome. Systems Engineer and Full Stack Developer."
  lang={lang}
>
  <Navbar lang={lang} />
  <main class="pt-16">
    <Hero lang={lang} />
    <Services lang={lang} />
    <Projects lang={lang} />
    <Skills lang={lang} />
    <Experience lang={lang} />
    <Studies lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>