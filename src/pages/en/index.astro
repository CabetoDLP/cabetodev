---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Skills from '../../components/Skills.astro';
import Experience from '../../components/Experience.astro';
import Studies from '../../components/Studies.astro';
import Projects from '../../components/Projects.astro';
import Files from '../../components/Files.astro';
import Contact from '../../components/Contact.astro';

const lang = 'english';
---

<Layout 
  title="Carlos de la Peña | Full Stack Engineer & Portfolio" 
  description="Official portfolio of Carlos Alberto de la Peña Jácome. Full Stack Software Engineer." 
  lang={lang}
>
  <Navbar lang={lang} />
  <main class="pt-16">
    <Hero lang={lang} />
    <Skills lang={lang} />
    <Experience lang={lang} />
    <Studies lang={lang} />
    <Projects lang={lang} />
    <Contact lang={lang} />
    <Files lang={lang} />
  </main>
</Layout>